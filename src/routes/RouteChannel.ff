import Lux from ff:lux
import LuxEvent from ff:lux
import Css from ff:lux
import WebServer from ff:webserver
import WebRoute from ff:webserver
import WebSocket from ff:websocket
import Pg from ff:postgresql
import Router
import Html
import Layout
import ChatChannel
import ChatService

routeModule = SourceLocation.here().directoryAndModule()

data PageData(channel: String, channels: List[ChatChannel])

handle(request: WebRequest[WebResponse], context: RouteContext, channelName: String) {
    let pageData = context.databasePool.transaction {connection => 
        let channels = ChatService.loadChannels(connection)
        PageData(channelName, channels)
    }
    if(!pageData.channels.any {_.name == channelName}) {
        request.writeStatus("307 Temporary Redirect")
        let origin = request.readHeader("origin").filter {_ != "null"}.else {
            "http://" + request.readHeader("host").grab()
        }
        request.writeHeader("Location", origin + Router.frontRoute.toUrl())
    } else {
        Html.renderAndServe(context.system, routeModule, pageData, channelName, request, {render(_, None, pageData)})
    }
}

browserMain(system: BrowserSystem) {
    Html.renderToMain(system, {render(_, Some(system), _)})
}

render(lux: Lux, system: Option[BrowserSystem], data: PageData) {
    let seenMessages: List[ChatMessage] = data.channels.find {_.name == data.channel}.map {_.messages}.else {[]}
    let webSocketUrl = Router.webSocketRoute.toUrl(data.channel, seenMessages.size())
    Layout.layout(lux, data.channels) {lux =>
        lux.useSuspense {lux.div {lux.text("Loading...")}}: lux =>
        lux.div:
        lux.useState(seenMessages): messages, setMessages =>
        lux.useWebSocket(webSocketUrl) {buffer =>
            let newMessages = Serializable.deserialize(buffer)
            setMessages([...messages, ...newMessages])
        }: sendOnWebSocket =>
        lux.div {
            lux.useState(""): draft, setDraft =>
            lux.cssClass(channelCss)
            lux.div {
                lux.cssClass(conversationAreaCss)
                messages.each {m =>
                    lux.div {
                        lux.text(m.time.map {showTime(system.grab().date(), _)}.else {""} + " " + m.text)
                    }
                }
            }
            lux.form {
                lux.on("submit") {event => 
                    event.preventDefault()
                    let buffer = Serializable.serialize(ChatMessage(None, draft))
                    sendOnWebSocket(buffer)
                    setDraft("")
                }
                lux.cssClass(writingAreaCss)
                lux.input {
                    lux.set("autofocus", "")
                    lux.cssClass(chatFieldCss)
                    lux.set("type", "text")
                    lux.set("placeholder", "Message #" + data.channel)
                    lux.setValue(draft)
                    lux.onInput {event =>
                        setDraft(event.text())
                    }
                }
            }
        }
    }
}

showTime(currentTime: Date, date: Date): String {
    let danishDate = date.withTimeZone("Europe/Copenhagen")
    let time = danishDate.hour().pad("00") + ":" + danishDate.minute().pad("00")
    if(currentTime.daysSince(date) < 1.0) {time} else:
    let day = danishDate.day() + "/" + danishDate.month()
    if(currentTime.yearsSince(date) < 1.0) {day + " " + time} else:
    day + " " + danishDate.year()
}

channelCss = CssClass([
    Css.padding("10px")
    Css.boxSizing("border-box")
    Css.width("100%")
    Css.height("100%")
    Css.display("flex")
    Css.flexDirection("column")
    Css.gap("20px")
], [], [])

conversationAreaCss = CssClass([
    Css.width("100%")
    Css.flex("1")
    Css.display("flex")
    Css.flexDirection("column")
    Css.gap("14px")
    Css.overflowY("scroll")
], [], [])

writingAreaCss = CssClass([
    Css.height("60px")
    Css.display("flex")
    Css.alignItems("center")
    Css.justifyContent("center")
], [], [])

chatFieldCss = CssClass([
    Css.backgroundColor("#333333")
    Css.color("#ffffff")
    Css.boxSizing("border-box")
    Css.width("100%")
    Css.paddingTop("13px")
    Css.paddingBottom("15px")
    Css.paddingLeft("17px")
    Css.paddingRight("17px")
    Css.fontSize("18px")
    Css.borderRadius("6px")
    Css.border("1px solid #666666")
    Css.outline("none")
], [
    CssNest("&:focus", [
        Css.borderColor("#aaaaaa")
    ], [])
], [])
