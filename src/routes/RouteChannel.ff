import Lux from ff:lux
import LuxEvent from ff:lux
import WebServer from ff:webserver
import Router
import Html
import Layout
import ChatChannel
import Css from ff:lux

routeModule = SourceLocation.here().directoryAndModule()

data PageData(channel: String, channels: List[ChatChannel])

handle(request: WebRequest[WebResponse], context: RouteContext, channel: String) {
    let pageData = PageData(channel, context.channels)
    Html.renderAndServe(context.system, routeModule, pageData, channel, request, {render(_, pageData)})
}

browserMain(system: BrowserSystem) {
    Html.renderToMain(system, {render(_, _)})
}

render(lux: Lux, data: PageData) {
    Layout.layout(lux, data.channels) {lux =>
        lux.useState([]): messages, setMessages =>
        lux.div {
            lux.useState(""): draft, setDraft =>
            lux.cssClass(channelCss)
            lux.div {
                lux.cssClass(conversationAreaCss)
                messages.each {m =>
                    let m2: ChatMessage = m // TODO
                    lux.div {
                        lux.text("Message: " + m.text)
                    }
                }
            }
            lux.form {
                lux.on("submit") {event => 
                    event.preventDefault()
                    setMessages([...messages, ChatMessage(data.channel, draft)])
                    setDraft("")
                }
                lux.cssClass(writingAreaCss)
                lux.input {
                    lux.set("autofocus", "")
                    lux.cssClass(chatFieldCss)
                    lux.set("type", "text")
                    lux.set("placeholder", "Message #" + data.channel)
                    lux.setValue(draft)
                    lux.onInput {event =>
                        setDraft(event.text())
                    }
                }
            }
        }
    }
}

channelCss = CssClass([
    Css.padding("10px")
    Css.boxSizing("border-box")
    Css.width("100%")
    Css.height("100%")
    Css.display("flex")
    Css.flexDirection("column")
    Css.gap("20px")
], [], [])

conversationAreaCss = CssClass([
    Css.width("100%")
    Css.flex("1")
    Css.display("flex")
    Css.flexDirection("column")
    Css.gap("14px")
    Css.overflowY("scroll")
], [], [])

writingAreaCss = CssClass([
    Css.height("60px")
    Css.display("flex")
    Css.alignItems("center")
    Css.justifyContent("center")
], [], [])

chatFieldCss = CssClass([
    Css.backgroundColor("#333333")
    Css.color("#ffffff")
    Css.boxSizing("border-box")
    Css.width("100%")
    Css.paddingTop("13px")
    Css.paddingBottom("15px")
    Css.paddingLeft("17px")
    Css.paddingRight("17px")
    Css.fontSize("18px")
    Css.borderRadius("6px")
    Css.border("1px solid #666666")
    Css.outline("none")
], [
    CssNest("&:focus", [
        Css.borderColor("#aaaaaa")
    ], [])
], [])
