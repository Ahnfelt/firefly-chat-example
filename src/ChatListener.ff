import WebSocket from ff:websocket
import ChatChannel

open(browserSystem: BrowserSystem): WebSocket {
    WebSocket.open(browserSystem, "/_websocket")
}

listen(task: Task, socket: WebSocket, onMessage: ChatMessage => Unit) {
    task.spawn {_ =>
        while {True} {
            let buffer = socket.readBuffer().grab()
            let message: ChatMessage = Serializable.deserialize(buffer)
            onMessage(message)
        }  
    }
}
