import Lux from ff:lux
import Css from ff:lux
import WebRoute from ff:webserver
import Router
import ChatChannel

layout(lux: Lux, channels: List[ChatChannel], content: Lux => Unit) {
    lux.div {
        lux.cssClass(layoutCss)
        menu(lux, channels)
        lux.div {
            lux.cssClass(contentCss)
            content(lux)
        }
    }
}

menu(lux: Lux, channels: List[ChatChannel]) {
    lux.div {
        lux.cssClass(menuCss)
        lux.add("a") {
            lux.cssClass(menuItemCss)
            lux.set("href", Router.frontRoute.toUrl())
            lux.div {
                lux.cssClass(menuItemSymbolCss)
                lux.text("＋")
            }
            lux.div {
                lux.cssClass(menuItemNameCss)
                lux.text("New Channel")
            }
        }
        channels.each {channel =>
            lux.add("a") {
                lux.cssClass(menuItemCss)
                lux.set("href", Router.channelRoute.toUrl(channel.name))
                lux.div {
                    lux.cssClass(menuItemSymbolCss)
                    lux.text("#")
                }
                lux.div {
                    lux.cssClass(menuItemNameCss)
                    lux.text(channel.name)
                }
            }
        }
    }
}

layoutCss = CssClass(
    css = [
        Css.display("flex")
        Css.width("100vw")
        Css.height("100vh")
        Css.backgroundColor("#141414")
        Css.color("#ffffff")
    ]
    nested = []
    keyframes = []
)

menuCss = CssClass(
    css = [
        Css.display("flex")
        Css.flexDirection("column")
        Css.gap("15px")
        Css.boxSizing("border-box")
        Css.width("350px")
        Css.padding("15px")
        Css.backgroundColor("#141414")
    ]
    nested = []
    keyframes = []
)

menuItemSymbolCss = CssClass(
    css = [
        Css.color("#696969")
        Css.fontSize("16px")
        Css.fontWeight("600")
        Css.width("20px")
    ]
    nested = []
    keyframes = []
)

menuItemCss = CssClass(
    css = [
        Css.color("#696969")
        Css.display("flex")
        Css.alignItems("center")
        Css.gap("10px")
        Css.boxSizing("border-box")
        Css.width("100%")
        Css.paddingTop("8px")
        Css.paddingBottom("8px")
        Css.paddingLeft("10px")
        Css.paddingRight("10px")
        Css.borderRadius("8px")
        Css.textDecoration("none")
    ]
    nested = [
        CssNest("&:hover", [
            Css.color("#bdbdbd")
            Css.backgroundColor("#252525")
        ], [
            CssNest(menuItemSymbolCss.selector(), [
                Css.color("#ffffff")
            ], [])
        ])        
    ]
    keyframes = []
)

menuItemNameCss = CssClass(
    css = [
        Css.fontSize("16px")
        Css.fontWeight("600")
    ]
    nested = []
    keyframes = []
)

contentCss = CssClass(
    css = [
        Css.flex("1")
        Css.backgroundColor("#242424")
    ]
    nested = []
    keyframes = []
)
