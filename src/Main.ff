import WebServer from ff:webserver
import Router
import WebRoute from ff:webserver
import RpcHandler
import Rpc from ff:rpc
import ChatChannel

nodeMain(system: NodeSystem): Unit {
    let context = RouteContext(system, [])
    let handlers = WebRouteHandler(Array.new())
    let rpcServer = RpcHandler.newServer(context)

    Router.handlers(handlers)
    let webServer = WebServer.new(system, "0.0.0.0", 8080)
    let topic = "chat"
    webServer.enableWebSockets()
    webServer.listen {request =>
        request.readPath().{
            | _ {request.needsWebSocket()} => 
                let webSocket = request.openWebSocket()
                webSocket.subscribe(topic)
                webSocket.writeBuffer(Serializable.serialize(ChatMessage("hej", "fra server")))
                webSocket.readStream().eachWhile {buffer =>
                    let message: ChatMessage = Serializable.deserialize(buffer)
                    let serialized = Serializable.serialize(message)
                    webSocket.writeBuffer(serialized)
                    webSocket.publishBuffer(topic, serialized)
                    True
                }
            | path {path.removeFirst("/_rpc/") | Some(name)} =>
                let input = request.readBuffer()
                rpcServer.handle(name, context, input).{
                    | None => request.writeStatus("404 Not found")
                    | Some(output) => request.writeBuffer(output)
                }
            | path {path.removeFirst("/_assets/") | Some(file)} => 
                serveAssets(system, request, "/assets/" + file)
            | path {path.removeFirst("/_js/") | Some(file)} => 
                serveAssets(system, request, "/js/" + file)
            | _ {handlers.handle(request, context)} =>
            | _ =>
                request.writeStatus("404 Not found")
        }
    }
}


serveAssets(system: NodeSystem, request: WebRequest[WebResponse], asset: String): Unit {
    if(!system.assets().exists(asset)) {
        request.writeStatus("404 Not Found")
    } else:
    
    guessContentType(asset).or {
        request.writeStatus("404 Not Found")
    }: contentType =>

    request.writeHeader("Content-Type", contentType)
    request.writeStream(system.assets().readStream(asset))
}

guessContentType(path: String): Option[String] {
    path.split('.').last().flatMap {
        | "js" => Some("text/javascript; charset=UTF-8")
        | "png" => Some("image/png")
        | "webp" => Some("image/webp")
        | "woff2" => Some("font/woff2")
        | _ => None
    }
}

buildMain(system: BuildSystem) {
    mutable assets = AssetSystem.create()
    let browserAssets = system.bundleForBrowser(Router.modulesWithBrowserMain().map {_ + ".ff"}, sourceMaps = True)
    assets = assets.addAssets("/js/", browserAssets)
    assets = assets.addAssets("/assets/", system.packageAssets().assets("/assets/"))
    system.setAssets(assets)
}
